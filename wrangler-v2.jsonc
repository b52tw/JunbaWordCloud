{
  "name": "junba-wordcloud-v2",
  "main": "online/worker.mjs",
  "account_id": "b6922ae6e76633c3d175e1452ceadc36",
  "compatibility_date": "2025-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "web",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "BANK",
      "database_name": "junba-wordcloud-v2-bank",
      "database_id": "f227611e-f095-4a1d-86cb-1c0bd8e7313a"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "WordCloudRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "WordCloudRoom"
      ]
    }
  ]
}
